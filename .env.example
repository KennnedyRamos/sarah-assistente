# Copie para .env e ajuste. NUNCA coloque senhas ou tokens aqui: a senha do Jarvis fica
# só como hash em data/jarvis.db (python -m jarvis.setpass).

# Modelo do Ollama (precisa estar baixado: ollama pull qwen3.5:4b). Modelos "cloud" são recusados.
JARVIS_MODEL=qwen3.5:4b
# Servidor de inferência. Só endereços locais são aceitos.
JARVIS_LLM_URL=http://127.0.0.1:11434
JARVIS_NUM_CTX=16384
# Por quanto tempo o modelo fica carregado na GPU depois do último uso.
JARVIS_KEEP_ALIVE=30m
# Criatividade do modelo (0 a 2). 0.7 é a recomendação da Qwen para respostas diretas; mais alto inventa mais.
JARVIS_TEMPERATURE=0.7
JARVIS_PORT=8765
JARVIS_SESSION_HOURS=12
# Mensagens anteriores enviadas como contexto.
JARVIS_HISTORY_MESSAGES=20
# Hostnames extras aceitos (ex.: o nome do PC na tailnet, maquina.tailnet-xyz.ts.net). Separe por vírgula.
JARVIS_ALLOWED_HOSTS=
# Sessões remotas (celular) usam só ferramentas de leitura. "true" libera ações (sempre com confirmação). Não recomendado.
JARVIS_REMOTE_TOOLS_ALL=false
# Internet: chave grátis da Tavily (1.000 buscas/mês, sem cartão). Sem ela, a busca usa só a Wikipédia.
JARVIS_TAVILY_KEY=
# Contato (seu e-mail ou site) que a Wikipédia exige no identificador do programa.
JARVIS_WEB_CONTACT=
# Endereço a partir da localização (Google Geocoding; exige projeto com faturamento; trave a cota). Opcional.
JARVIS_GOOGLE_MAPS_KEY=
# Reconhecimento facial opcional (on/off). Exige python -m jarvis.face (baixa os modelos). Veja INTEGRATIONS.md.
JARVIS_FACE=off
# Índice da webcam (0 = a primeira).
JARVIS_CAMERA=0
# Usar a câmera do PC (reconhecer, cadastrar, tirar foto) pelo celular. Desligado por padrão.
JARVIS_REMOTE_CAMERA=false
# Voz. Modelo de transcrição: tiny, base, small (padrão), medium, large-v3-turbo. Rode python -m jarvis.voice após trocar.
JARVIS_WHISPER_MODEL=small
# Escuta local no PC: off (padrão), palavra, palmas ou ambos.
JARVIS_WAKE=off
# Pico mínimo de uma palma (0 a 1). Prefira a calibração na aba Voz, que vale mais que este valor.
JARVIS_CLAP_MIN_PEAK=0.2
# Microfone da escuta local: número ou parte do nome (vazio = padrão do Windows). A escolha na aba Voz vale mais.
JARVIS_WAKE_DEVICE=
# Pasta dos modelos de voz (padrão: data/models).
# JARVIS_MODELS_DIR=C:\dev\JarvisLocal\data\models
# Pasta de dados (banco, logs, modelos de voz).
# JARVIS_DATA_DIR=C:\dev\JarvisLocal\data
